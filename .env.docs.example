# 실제 인증정보는 이 파일이나 Git에 저장하지 마세요.
# 로컬 JoyGrow 소스의 절대 경로를 지정하면 데모 모드로 학생·관리자 화면을 캡처합니다.
JOYGROW_SOURCE_DIR=C:\path\to\joygrow
ATTENDANCE_SOURCE_DIR=C:\path\to\songrim-attendance

# 필요할 때만 주소를 덮어씁니다.
# JOYGROW_BASE_URL=http://127.0.0.1:3117
# ATTENDANCE_BASE_URL=https://songrim-attendance.netlify.app

# 출석부 교사/관리자 화면은 문서 촬영 전용 DEMO 계정을 준비한 뒤 사용합니다.
# ATTENDANCE_DEMO_NAME=
# ATTENDANCE_DEMO_PIN=
# 실제 개인정보가 없는 촬영 전용 계정임을 확인한 경우에만 1로 설정합니다.
# DOCS_DEMO_DATA_CONFIRMED=1
